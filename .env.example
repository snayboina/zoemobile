# ZOESTOCK MOBILE - VARIÁVEIS DE AMBIENTE (MODELO)
# NUNCA insira credenciais reais de produção aqui.
# No Expo, variáveis públicas acessíveis no bundle devem iniciar com EXPO_PUBLIC_

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-supabase.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_OFFLINE_MOCK=true
